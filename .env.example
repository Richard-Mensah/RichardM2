# Copy to .env.local and fill in. Everything is optional for local development:
# without DATABASE_URL the public site renders from built-in defaults.

# Postgres (Neon: append ?sslmode=require)
DATABASE_URL=

# Admin panel (/admin)
ADMIN_PASSWORD=
# Signs admin session cookies. Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Vercel Blob, for gallery uploads (set automatically when a Blob store is connected in Vercel)
BLOB_READ_WRITE_TOKEN=

# GitHub activity section on the homepage (optional). Without it, public repos +
# the public contribution calendar are used. With it, private repos are counted
# (names are never shown) and the calendar comes from the GraphQL API.
# Create at github.com → Settings → Developer settings → Personal access tokens.
GITHUB_TOKEN=

# Canonical site URL (defaults to https://www.richmensah.com)
NEXT_PUBLIC_SITE_URL=
